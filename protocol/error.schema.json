{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguins-eggs.net/schemas/penguins/v1/error.schema.json",
  "title": "Penguins terminal error",
  "type": "object",
  "required": [
    "protocol", "type", "request_id", "run_id", "sequence", "timestamp",
    "tool", "tool_version", "operation", "state", "message", "error"
  ],
  "properties": {
    "protocol": {"const": "penguins/v1"},
    "type": {"const": "error"},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "tool": {"enum": ["eggs", "tailor", "krill"]},
    "tool_version": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "state": {"enum": ["failed", "cancelled"]},
    "message": {"type": "string"},
    "error": {
      "type": "object",
      "required": ["code", "recoverable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "recoverable": {"type": "boolean"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
