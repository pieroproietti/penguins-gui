{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguins-eggs.net/schemas/penguins/v1/request.schema.json",
  "title": "Penguins tool request",
  "type": "object",
  "required": ["protocol", "request_id", "tool", "operation", "options"],
  "properties": {
    "protocol": {"const": "penguins/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "tool": {"enum": ["eggs", "tailor", "krill"]},
    "operation": {"type": "string", "minLength": 1},
    "options": {"type": "object"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {"const": "eggs"},
          "operation": {"const": "remaster"}
        },
        "required": ["tool", "operation"]
      },
      "then": {
        "properties": {
          "options": {"$ref": "#/$defs/eggsRemasterOptions"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {"const": "tailor"},
          "operation": {"const": "wear"}
        },
        "required": ["tool", "operation"]
      },
      "then": {
        "properties": {
          "options": {"$ref": "#/$defs/tailorWearOptions"}
        }
      }
    }
  ],
  "$defs": {
    "compression": {
      "type": "object",
      "required": ["algorithm", "level"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "level": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "eggsRemasterOptions": {
      "type": "object",
      "required": ["mode", "working_directory"],
      "properties": {
        "mode": {"enum": ["standard", "clone", "crypted"]},
        "working_directory": {"type": "string", "pattern": "^/"},
        "target_directory": {"type": "string", "pattern": "^/"},
        "compression": {"$ref": "#/$defs/compression"}
      },
      "additionalProperties": false
    },
    "tailorWearOptions": {
      "type": "object",
      "required": ["costume"],
      "properties": {
        "costume": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "dry_run": {"type": "boolean"},
        "add": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "remove": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
