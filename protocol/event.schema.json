{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguins-eggs.net/schemas/penguins/v1/event.schema.json",
  "title": "Penguins progress event",
  "type": "object",
  "required": [
    "protocol", "type", "request_id", "run_id", "sequence", "timestamp",
    "tool", "tool_version", "operation", "state", "message"
  ],
  "properties": {
    "protocol": {"const": "penguins/v1"},
    "type": {"const": "event"},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "tool": {"enum": ["eggs", "tailor", "krill"]},
    "tool_version": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "state": {"enum": ["pending", "running", "waiting_for_input"]},
    "step": {"$ref": "#/$defs/step"},
    "progress": {"$ref": "#/$defs/progress"},
    "message": {"type": "string"},
    "data": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "state": {"enum": ["pending", "running", "succeeded", "failed", "cancelled"]}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["current", "total", "unit"],
      "properties": {
        "current": {"type": "number", "minimum": 0},
        "total": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
